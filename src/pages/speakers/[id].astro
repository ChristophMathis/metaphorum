---
import { getEmDashCollection, getEmDashEntry } from 'emdash';
import { Image, PortableText } from 'emdash/ui';
import Layout from '../../layouts/Layout.astro';
import {
  buildEntryLookup,
  portableTextToPlainText,
  referenceIds,
} from '../../lib/conference';

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

const { entry: speaker, cacheHint } = await getEmDashEntry('speakers', id);
if (!speaker) return Astro.redirect('/404');
Astro.cache.set(cacheHint);

// Resolve the speaker's session references to full session entries
const { entries: allSessions } = await getEmDashCollection('sessions', {
  status: 'published',
});
const sessionsById = buildEntryLookup(allSessions);
const speakerSessions = referenceIds(speaker.data.sessions)
  .map(ref => sessionsById.get(ref))
  .filter(session => session !== undefined);
---

<Layout title={speaker.data.name}>
  <div class="container profile-container">
    <div class="back-link">
        <a href="/speakers">&larr; Back to all speakers</a>
    </div>

    <div class="profile-header">
        {speaker.data.image && (
            <div class="profile-image" {...speaker.edit.image}>
                <Image image={speaker.data.image} alt={speaker.data.image.alt || speaker.data.name} />
            </div>
        )}
        <div class="profile-info">
            <h1 {...speaker.edit.name}>{speaker.data.name}</h1>
            {speaker.data.abstract && (
                <p class="speaker-abstract" {...speaker.edit.abstract}>{speaker.data.abstract}</p>
            )}
        </div>
    </div>

    {speaker.data.profile && (
        <div class="profile-bio" {...speaker.edit.profile}>
            <h2>Profile</h2>
            <PortableText value={speaker.data.profile} />
        </div>
    )}

    {speakerSessions.length > 0 && (
        <div class="profile-talks">
            <h2>Sessions</h2>
            <div class="talks-list">
                {speakerSessions.map(session => (
                    <div class="talk-item">
                        <h3><a href={`/sessions/${session.id}`}>{session.data.title}</a></h3>
                        <p class="talk-abstract">{portableTextToPlainText(session.data.abstract)}</p>
                    </div>
                ))}
            </div>
        </div>
    )}
  </div>
</Layout>

<style>
    .profile-container {
        padding-top: 2rem;
        padding-bottom: 4rem;
    }

    .back-link {
        margin-bottom: 2rem;
    }

    .profile-header {
        display: flex;
        gap: 2rem;
        align-items: center;
        margin-bottom: 3rem;
    }

    .profile-image :global(img) {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--color-background-alt);
    }

    .speaker-abstract {
        font-size: 1.25rem;
        color: var(--color-text-light);
    }

    .profile-bio, .profile-talks {
        max-width: 800px;
        margin-bottom: 3rem;
    }

    .talk-item {
        background: var(--color-background-alt);
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .talk-item h3 {
        font-size: 1.2rem;
        margin-top: 0;
    }

    .talk-abstract {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .profile-header {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
