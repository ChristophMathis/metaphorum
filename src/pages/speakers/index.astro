---
import { getEmDashCollection } from 'emdash';
import Layout from '../../layouts/Layout.astro';
import SpeakerCard from '../../components/SpeakerCard.astro';

const { entries: speakers, cacheHint } = await getEmDashCollection('speakers', {
	status: 'published',
});
Astro.cache.set(cacheHint);

// Sort speakers alphabetically by sort name (e.g. "Espinosa, Angela")
const sortedSpeakers = speakers.toSorted((a, b) =>
	(a.data.sort_name || a.data.name).localeCompare(b.data.sort_name || b.data.name)
);
---

<Layout title="Speakers">
	<section class="page-header">
        <div class="container">
            <h1>Speakers</h1>
        </div>
    </section>

    <section class="content">
        <div class="container">
            {sortedSpeakers.length === 0 ? (
                <p class="empty-note">No speakers have been published yet. Add speakers in the <a href="/_emdash/admin">admin panel</a>.</p>
            ) : (
                <div class="speakers-grid">
                    {sortedSpeakers.map(speaker => (
                        <SpeakerCard
                            id={speaker.id}
                            name={speaker.data.name}
                            subtitle={speaker.data.abstract}
                            image={speaker.data.image}
                        />
                    ))}
                </div>
            )}
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background: var(--color-primary);
        color: white;
        padding: 3rem 0;
    }

    .speakers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .empty-note {
        margin-top: 2rem;
        color: var(--color-text-light);
    }
</style>
